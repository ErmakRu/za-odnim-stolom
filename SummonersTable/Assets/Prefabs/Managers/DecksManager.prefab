    - id: cozy
      name: "\u0416\u0438\u0432\u0451\u043C \u0434\u0430\u043B\u044C\u0448\u0435"
      subtitle: "\u0417\u0430\u0449\u0438\u0442\u0430, \u043B\u0435\u0447\u0435\u043D\u0438\u0435,
        \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0435 \u0440\u0438\u0442\u0443\u0430\u043B\u044B"
      guide: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u0430,
        \u0437\u0430\u0442\u0435\u043C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
        \u043B\u0435\u0447\u0435\u043D\u0438\u044F. \u0421\u043E\u0445\u0440\u0430\u043D\u044F\u0439\u0442\u0435
        \u0440\u0435\u0430\u043A\u0446\u0438\u0438 \u0434\u043B\u044F \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E
        \u0443\u0440\u043E\u043D\u0430 \u0438 \u0437\u0430\u0449\u0438\u0449\u0430\u0439\u0442\u0435
        \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432.
        \u041B\u0435\u0447\u0435\u043D\u0438\u0435 \u043C\u043E\u0436\u043D\u043E
        \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0443
        \u0440\u0430\u0434\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
        \u0441\u043E\u044E\u0437\u0430. \u0412\u044B \u043E\u0448\u0438\u0431\u043B\u0438\u0441\u044C
        \u0441\u0442\u043E\u043B\u0438\u043A\u043E\u043C \u0443\u0431\u0438\u0440\u0430\u0435\u0442
        \u043E\u043F\u0430\u0441\u043D\u044B\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B
        \u0438\u043B\u0438 \u0441\u043F\u0430\u0441\u0430\u0435\u0442 \u0432\u0430\u0448\u0435\u0433\u043E
        \u0431\u043E\u0439\u0446\u0430."
