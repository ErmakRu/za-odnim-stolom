  decks:
    schemaVersion: 1
    decks:
    - id: noise
      name: "\u0428\u0443\u043C\u043D\u0430\u044F \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F"
      subtitle: "\u0414\u0430\u0432\u043B\u0435\u043D\u0438\u0435, \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u044F,
        \u0432\u043E\u0437\u0432\u0440\u0430\u0442 \u043F\u0440\u0438\u0437\u044B\u0432\u043E\u0432"
      guide: "\u041D\u0430\u0447\u043D\u0438\u0442\u0435 \u0441 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430
        \u0438 \u043D\u0435 \u043E\u0442\u0434\u0430\u0432\u0430\u0439\u0442\u0435
        \u0441\u0442\u043E\u043B \u0431\u0435\u0437 \u0431\u043E\u0440\u044C\u0431\u044B.
        \u0423\u0441\u0438\u043B\u0438\u0442\u0435\u043B\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442
        \u0443\u0440\u043E\u043D \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445
        \u043A\u0430\u0440\u0442. \u0421\u043B\u0430\u0431\u043E \u0435\u0449\u0451
        \u0434\u0432\u0435? \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u0439\u0442\u0435
        \u0434\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430, \u043A\u043E\u0433\u0434\u0430
        \u0443\u0432\u0435\u0440\u0435\u043D\u044B \u0432 QTE. \u0412\u044B\u0431\u0438\u0440\u0430\u0439\u0442\u0435
        \u043C\u0435\u0436\u0434\u0443 \u0430\u0442\u0430\u043A\u043E\u0439 \u0433\u0435\u0440\u043E\u044F
        \u0438 \u0443\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435\u043C
        \u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0433\u043E
        \u044D\u0444\u0444\u0435\u043A\u0442\u0430."
      entries:
      - cardId: C03
        count: 3
      - cardId: C06
        count: 3
      - cardId: C09
        count: 3
