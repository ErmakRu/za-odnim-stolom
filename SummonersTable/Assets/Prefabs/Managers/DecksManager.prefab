    - id: tricks
      name: "\u041C\u0435\u043B\u043A\u0438\u0435 \u043F\u0430\u043A\u043E\u0441\u0442\u0438"
      subtitle: "\u0414\u043E\u0431\u043E\u0440, \u043E\u0431\u043C\u0435\u043D\u044B,
        \u043F\u043E\u043C\u0435\u0445\u0438 QTE"
      guide: "\u0420\u0430\u0437\u0432\u0438\u0432\u0430\u0439\u0442\u0435 \u0434\u043E\u0431\u043E\u0440,
        \u043D\u043E \u0441\u043B\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u043B\u0438\u043C\u0438\u0442\u043E\u043C
        \u0440\u0443\u043A\u0438. \u041F\u043E\u043C\u0435\u0445\u0438 \u0443\u0441\u043B\u043E\u0436\u043D\u044F\u044E\u0442
        \u0440\u0438\u0442\u0443\u0430\u043B\u044B \u0432\u0441\u0435\u0445 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432.
        \u0422\u0435\u0445\u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430
        \u0441\u0442\u0440\u0430\u0445\u0443\u0435\u0442 \u0432\u0430\u0448\u0438
        \u043E\u0448\u0438\u0431\u043A\u0438. \u041E\u0431\u043C\u0435\u043D \u0438
        \u0432\u043E\u0437\u0432\u0440\u0430\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432
        \u043C\u0435\u043D\u044F\u044E\u0442 \u043F\u043B\u0430\u043D\u044B \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u043E\u0432;
        \u0440\u0435\u0430\u043A\u0446\u0438\u0438 \u043A\u043E\u043F\u0438\u0440\u0443\u044E\u0442
        \u0447\u0443\u0436\u0438\u0435 \u043F\u0440\u0438\u0437\u044B\u0432\u044B
        \u0438\u043B\u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442
        \u0438\u0445 \u0432 \u0440\u0443\u043A\u0443. \u041A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
        \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0433\u043E
        \u0441\u043B\u043E\u0442\u0430 \u0441 \u0442\u0435\u043C \u0436\u0435 \u043D\u043E\u043C\u0435\u0440\u043E\u043C."
      entries:
