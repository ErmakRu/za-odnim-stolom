        \u0435\u0433\u043E \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430.
        \u0415\u0433\u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439
        \u044D\u0444\u0444\u0435\u043A\u0442 \u0441\u0440\u0430\u0437\u0443 \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442.
        \u041F\u0440\u0438 \u043F\u043E\u043B\u043D\u043E\u0439 \u0440\u0443\u043A\u0435
        \u043A\u0430\u0440\u0442\u0430 \u0441\u0433\u043E\u0440\u0430\u0435\u0442."
      flavor: "\u0412\u0430\u0448 \u0440\u0438\u0442\u0443\u0430\u043B \u0432 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u043C
        \u0437\u0430\u043B\u0435."
      art: art:S08
      attack: 0
      health: 0
      qte: 4
      value: 1
    - id: R01
      name: "\u042F \u0432\u043E\u043E\u0431\u0449\u0435 \u043C\u0438\u043C\u043E"
      kind: reaction
      faction: 
      role: 
      effect: reduce
      target: pending
      rules: "\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0440\u043E\u0437\u044B\u0433\u0440\u044B\u0448\u0430
        \u0447\u0443\u0436\u043E\u0433\u043E \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F:
        \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u0435 \u0443\u0440\u043E\u043D
        \u044D\u0442\u043E\u0439 \u043A\u0430\u0440\u0442\u044B \u0432\u0430\u043C
        \u043B\u0438\u0431\u043E \u0432\u0430\u0448\u0435\u043C\u0443 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443
        \u043D\u0430 3. \u041D\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
        \u043D\u0430 \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0430\u0442\u0430\u043A\u0438
        \u0441\u043E \u0441\u0442\u043E\u043B\u0430 \u0438 \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C."
      flavor: "\u041C\u0435\u043D\u044F \u0437\u0434\u0435\u0441\u044C \u0434\u0430\u0436\u0435
        \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043B\u0438 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E."
