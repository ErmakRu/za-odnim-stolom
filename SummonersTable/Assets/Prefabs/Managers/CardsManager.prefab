      name: "\u0427\u0443\u0436\u043E\u0439 \u043A\u043E\u043D\u0441\u043F\u0435\u043A\u0442"
      kind: spell
      faction: 
      role: 
      effect: draw
      target: self
      rules: "\u0414\u043E\u0431\u0435\u0440\u0438\u0442\u0435 2 \u043A\u0430\u0440\u0442\u044B.
        \u0412\u0441\u0451 \u0441\u0432\u0435\u0440\u0445 \u043B\u0438\u043C\u0438\u0442\u0430
        \u0440\u0443\u043A\u0438 \u0432 8 \u043A\u0430\u0440\u0442 \u0441\u0433\u043E\u0440\u0430\u0435\u0442."
      flavor: "\u041F\u043E\u0447\u0435\u0440\u043A \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0439.
        \u041C\u0430\u0433\u0438\u044F \u0440\u0430\u0431\u043E\u0447\u0430\u044F."
