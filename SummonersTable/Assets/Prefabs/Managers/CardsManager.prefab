    - id: S07
      name: "\u0421\u043B\u0430\u0431\u043E \u0435\u0449\u0451 \u0434\u0432\u0435?"
      kind: spell
      faction: 
      role: 
      effect: riskBoost
      target: self
      rules: "\u0412\u0430\u0448\u0435 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435
        \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u0432 \u044D\u0442\u043E\u0442
        \u0445\u043E\u0434 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 +2 \u0441\u0438\u043C\u0432\u043E\u043B\u0430
        \u043A QTE \u0438 +3 \u0443\u0440\u043E\u043D\u0430 \u043A \u043F\u0435\u0440\u0432\u043E\u0439
        \u0430\u0442\u0430\u043A\u0435 \u0432 \u043A\u043E\u043D\u0446\u0435 \u0445\u043E\u0434\u0430.
        \u0423\u0441\u0438\u043B\u0435\u043D\u0438\u0435 \u043E\u0434\u043D\u043E\u0440\u0430\u0437\u043E\u0432\u043E\u0435,
        \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
        \u0432 \u044D\u0442\u043E\u0442 \u0445\u043E\u0434 \u0438 \u043D\u0435 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F."
      flavor: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0441\u043B\u043E\u0432\u0430
        \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0433\u043E \u043C\u0430\u0433\u0430."
      art: art:S07
      attack: 0
      health: 0
      qte: 2
      value: 3
    - id: S08
      name: "\u0412\u044B \u043E\u0448\u0438\u0431\u043B\u0438\u0441\u044C \u0441\u0442\u043E\u043B\u0438\u043A\u043E\u043C"
