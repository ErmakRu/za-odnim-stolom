    cards:
    - id: C01
      name: "\u0415\u043D\u043E\u0442-\u043A\u0430\u0440\u043C\u0430\u043D\u043D\u0438\u043A"
      kind: creature
      faction: "\u0417\u0432\u0435\u0440\u0438"
      role: "\u0421\u043D\u0430\u0431\u0436\u0435\u043D\u0435\u0446"
      effect: spellDraw
      target: enemy
      rules: "\u041F\u0435\u0440\u0432\u043E\u0435 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0435
        \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435 \u0432 \u0432\u0430\u0448
        \u0445\u043E\u0434: \u0434\u043E\u0431\u0435\u0440\u0438\u0442\u0435 1 \u043A\u0430\u0440\u0442\u0443.
        \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u0430\u043A\u0438\u0445
        \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432 \u0434\u0430\u044E\u0442
        \u043D\u0435 \u0431\u043E\u043B\u0435\u0435 2 \u043A\u0430\u0440\u0442."
      flavor: "\u041E\u043D \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u043B,
        \u0445\u043E\u0440\u043E\u0448\u043E \u043B\u0438 \u043B\u0435\u0436\u0438\u0442."
      art: art:C01
      attack: 2
      health: 3
      qte: 3
      value: 1
    - id: C02
      name: "\u041C\u0435\u0434\u0432\u0435\u0434\u044C-\u043E\u0431\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C"
      kind: creature
      faction: "\u0417\u0432\u0435\u0440\u0438"
      role: "\u0417\u0430\u0449\u0438\u0442\u043D\u0438\u043A"
      effect: guard
      target: enemy
      rules: "\u0423\u0440\u043E\u043D \u0432\u0430\u0448\u0435\u043C\u0443 \u0433\u0435\u0440\u043E\u044E
        \u043E\u0442 \u0430\u0442\u0430\u043A \u0438 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439
        \u0443\u043C\u0435\u043D\u044C\u0448\u0435\u043D \u043D\u0430 1. \u041E\u0431\u0449\u0430\u044F
        \u0437\u0430\u0449\u0438\u0442\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432
        \u043D\u0435 \u0432\u044B\u0448\u0435 2; \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C
        \u043D\u0435 \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F."
      flavor: "\u041E\u0431\u043D\u0438\u043C\u0435\u0442 \u043A\u0440\u0435\u043F\u043A\u043E.
        \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0439
        \u0448\u0430\u0440."
      art: art:C02
      attack: 3
      health: 6
      qte: 4
      value: 1
    - id: C03
      name: "\u0411\u043E\u0435\u0432\u043E\u0439 \u0433\u0443\u0441\u044C"
      kind: creature
      faction: "\u0417\u0432\u0435\u0440\u0438"
      role: "\u0423\u0441\u0438\u043B\u0438\u0442\u0435\u043B\u044C"
      effect: attackAura
      target: enemy
      rules: "\u0414\u0440\u0443\u0433\u0438\u0435 \u0432\u0430\u0448\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430
