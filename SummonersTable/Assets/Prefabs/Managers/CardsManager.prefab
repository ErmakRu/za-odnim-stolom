        \u0441\u0430\u043C\u043E\u0433\u043E \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u0442\u0435\u043B\u044F."
      flavor: "\u042D\u0442\u043E \u043C\u043E\u0451. \u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
        \u043C\u043D\u0435 \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F."
