    - target: {fileID: 7827398144244464497, guid: 530e1546ce8a5f2459e7347ba6fbfee9, type: 3}
      propertyPath: definition.rules
      value: "\u0412\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0435 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u043E\u0435
        \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442
        \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E \u0430\u0442\u0430\u043A\u0443
        \u0432 \u043A\u043E\u043D\u0446\u0435 \u0445\u043E\u0434\u0430. \u0415\u0433\u043E
        \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439 \u044D\u0444\u0444\u0435\u043A\u0442
        \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C."
      objectReference: {fileID: 0}
    - target: {fileID: 7827398144244464497, guid: 530e1546ce8a5f2459e7347ba6fbfee9, type: 3}
