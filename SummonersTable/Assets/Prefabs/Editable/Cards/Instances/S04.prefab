    - target: {fileID: 7827398144244464497, guid: 530e1546ce8a5f2459e7347ba6fbfee9, type: 3}
      propertyPath: definition.name
      value: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
