        1 \u0443\u0440\u043E\u043D. \u041E\u0431\u0449\u0438\u0439 \u0448\u0442\u0440\u0430\u0444
        \u043E\u0442 \u0442\u0430\u043A\u0438\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432
        \u043D\u0435 \u0432\u044B\u0448\u0435 2. \u042D\u0442\u043E\u0442 \u0443\u0440\u043E\u043D
        \u043D\u0435 \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442 \u043E\u0442\u0432\u0435\u0442\u043D\u044B\u0445
        \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432."
