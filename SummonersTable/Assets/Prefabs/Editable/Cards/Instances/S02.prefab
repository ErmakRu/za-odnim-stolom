    - target: {fileID: 7827398144244464497, guid: 530e1546ce8a5f2459e7347ba6fbfee9, type: 3}
      propertyPath: definition.flavor
      value: "\u041F\u044F\u0442\u044C \u0435\u0434\u0438\u043D\u0438\u0446 \u0437\u0430\u0431\u043E\u0442\u044B,
        \u0431\u0435\u0437 \u043E\u0447\u0435\u0440\u0435\u0434\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 7827398144244464497, guid: 530e1546ce8a5f2459e7347ba6fbfee9, type: 3}
