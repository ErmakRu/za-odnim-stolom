      value: "\u041E\u0431\u043D\u0438\u043C\u0430\u0448\u043A\u0438 \u043F\u043E
        \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u044E"
      objectReference: {fileID: 0}
    - target: {fileID: 7827398144244464497, guid: 530e1546ce8a5f2459e7347ba6fbfee9, type: 3}
      propertyPath: definition.rules
      value: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435
        \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u043C\u0443 \u0436\u0438\u0432\u043E\u043C\u0443
        \u0433\u0435\u0440\u043E\u044E 5 HP, \u043D\u0435 \u0432\u044B\u0448\u0435
        30. \u041C\u043E\u0436\u043D\u043E \u043F\u043E\u043C\u043E\u0447\u044C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 7827398144244464497, guid: 530e1546ce8a5f2459e7347ba6fbfee9, type: 3}
