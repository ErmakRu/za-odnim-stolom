    - target: {fileID: 5052774128483617739, guid: f4ba0da282ee7614d862cbf3f507e42e, type: 3}
      propertyPath: definition.rules
      value: "\u041D\u0430 \u0447\u0443\u0436\u043E\u0439 \u043F\u0440\u0438\u0437\u044B\u0432:
        \u043F\u043E\u0441\u043B\u0435 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0433\u043E
        QTE \u0432\u0435\u0440\u043D\u0438\u0442\u0435 \u0440\u0430\u0437\u044B\u0433\u0440\u0430\u043D\u043D\u0443\u044E
        \u043A\u0430\u0440\u0442\u0443 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0443
        \u0432 \u0440\u0443\u043A\u0443. \u041F\u0440\u0438 \u043F\u043E\u043B\u043D\u043E\u0439
        \u0440\u0443\u043A\u0435 \u043E\u043D\u0430 \u0441\u0433\u043E\u0440\u0430\u0435\u0442.
        \u0423\u0436\u0435 \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0435
        \u043A\u043E\u043F\u0438\u0438 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F.
        \u041F\u0440\u0438 \u0441\u0440\u044B\u0432\u0435 QTE \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
        \u043E\u0431\u044B\u0447\u043D\u0430\u044F \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0430
        \u043A\u0430\u0440\u0442\u044B \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0443."
