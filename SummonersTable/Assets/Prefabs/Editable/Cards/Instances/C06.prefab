    - target: {fileID: 3946069371195679936, guid: 88d2ee25808501a4f905868b9132ec8c, type: 3}
      propertyPath: m_Text
      value: "\u0414\u0435\u043C\u043E\u043D\u044B \xB7 \u041F\u0440\u043E\u0432\u043E\u043A\u0430\u0442\u043E\u0440"
      objectReference: {fileID: 0}
    - target: {fileID: 4565121407692265677, guid: 88d2ee25808501a4f905868b9132ec8c, type: 3}
      propertyPath: m_Text
      value: "\u041A\u043E\u0433\u0434\u0430 \u0430\u0442\u0430\u043A\u0430 \u0438\u043B\u0438
        \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430
        \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0443\u0440\u043E\u043D \u0432\u0430\u0448\u0435\u043C\u0443
        \u0433\u0435\u0440\u043E\u044E, \u0435\u0433\u043E \u0433\u0435\u0440\u043E\u0439
        \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 1 \u043E\u0442\u0432\u0435\u0442\u043D\u043E\u0433\u043E
        \u0443\u0440\u043E\u043D\u0430. \u041C\u0430\u043A\u0441\u0438\u043C\u0443\u043C
        2; \u043E\u0442\u0432\u0435\u0442\u043D\u044B\u0439 \u0443\u0440\u043E\u043D
        \u043D\u0435 \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u043E\u0432\u044B\u0439
        \u043E\u0442\u0432\u0435\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 5877624294313918048, guid: 88d2ee25808501a4f905868b9132ec8c, type: 3}
      propertyPath: m_Text
      value: "\u0410\u0422\u041A 4   HP 4"
