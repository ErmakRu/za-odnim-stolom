    - target: {fileID: 4565121407692265677, guid: 88d2ee25808501a4f905868b9132ec8c, type: 3}
      propertyPath: m_Text
      value: "\u0412\u0430\u0448\u0438 QTE \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442
        +2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0442\u0430\u043A\u0438\u0445 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432
        \u0434\u0430\u044E\u0442 \u043D\u0435 \u0431\u043E\u043B\u0435\u0435 +4 \u0441\u0435\u043A\u0443\u043D\u0434."
