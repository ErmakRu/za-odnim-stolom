    - target: {fileID: 5052774128483617739, guid: f4ba0da282ee7614d862cbf3f507e42e, type: 3}
      propertyPath: definition.rules
      value: "\u041D\u0430 \u0447\u0443\u0436\u043E\u0439 \u043F\u0440\u0438\u0437\u044B\u0432:
        \u043F\u043E\u0441\u043B\u0435 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0433\u043E
        QTE \u0441\u043E\u0437\u0434\u0430\u0439\u0442\u0435 \u043A\u043E\u043F\u0438\u044E
        \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0432 \u0441\u043B\u043E\u0442\u0435
        \u0441 \u0442\u0435\u043C \u0436\u0435 \u043D\u043E\u043C\u0435\u0440\u043E\u043C
        \u0443 \u0441\u0435\u0431\u044F. \u0421\u043B\u043E\u0442 \u0434\u043E\u043B\u0436\u0435\u043D
        \u0431\u044B\u0442\u044C \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D.
        \u041A\u043E\u043F\u0438\u044F \u043D\u0435 \u0430\u0442\u0430\u043A\u0443\u0435\u0442
        \u0434\u043E \u0432\u0430\u0448\u0435\u0433\u043E \u0445\u043E\u0434\u0430;
        \u0435\u0451 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439
        \u044D\u0444\u0444\u0435\u043A\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
        \u0441\u0440\u0430\u0437\u0443. \u041F\u0440\u0438 \u0441\u0440\u044B\u0432\u0435
        QTE \u043A\u043E\u043F\u0438\u0438 \u043D\u0435\u0442."
      objectReference: {fileID: 0}
