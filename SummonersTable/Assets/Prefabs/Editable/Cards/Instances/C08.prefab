    - target: {fileID: 3946069371195679936, guid: 88d2ee25808501a4f905868b9132ec8c, type: 3}
      propertyPath: m_Text
      value: "\u041D\u0435\u0436\u0438\u0442\u044C \xB7 \u041B\u0435\u043A\u0430\u0440\u044C"
      objectReference: {fileID: 0}
    - target: {fileID: 4565121407692265677, guid: 88d2ee25808501a4f905868b9132ec8c, type: 3}
      propertyPath: m_Text
      value: "\u041A\u043E\u0433\u0434\u0430 \u0432\u0430\u0448\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E
        \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0443\u0440\u043E\u043D \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u043E\u043C\u0443
        \u0433\u0435\u0440\u043E\u044E, \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435
        \u0441\u0432\u043E\u0435\u043C\u0443 \u0433\u0435\u0440\u043E\u044E 1 HP.
        \u041D\u0435 \u0431\u043E\u043B\u0435\u0435 2 HP \u0437\u0430 \u043E\u0434\u043D\u0443
        \u0430\u0442\u0430\u043A\u0443 \u043E\u0442 \u0432\u0441\u0435\u0445 \u0442\u0430\u043A\u0438\u0445
        \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432."
      objectReference: {fileID: 0}
    - target: {fileID: 7013436705393275887, guid: 88d2ee25808501a4f905868b9132ec8c, type: 3}
      propertyPath: definition.id
